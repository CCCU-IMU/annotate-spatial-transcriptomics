{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CCCU-IMU/annotate-spatial-transcriptomics/schemas/annotation_contract.schema.json",
  "title": "V2 annotation execution contract",
  "type": "object",
  "required": [
    "schema_version", "framework_version", "skill_release_version", "project_id", "sample_id",
    "observation_unit",
    "project_config", "workflow_profile", "biological_profile", "candidate_catalog", "atlas_bundle",
    "threshold_registry", "candidate_context_policy",
    "selected_input_snapshot", "input_scope", "artifact_role_policy", "expression_ancestry_policy",
    "whole_tissue_partition", "query_reclustering", "broad_family_evidence",
    "canonical_lineage_controller",
    "atlas_routing", "release_taxonomy"
  ],
  "properties": {
    "schema_version": {"const": "2.0"},
    "framework_version": {"const": "2.0.0"},
    "skill_release_version": {"enum": ["2.2.0", "2.5.0"]},
    "project_id": {"type": "string", "minLength": 1},
    "sample_id": {"type": "string", "minLength": 1},
    "observation_unit": {"enum": ["cell", "nucleus", "cellbin", "spot"]},
    "project_config": {"$ref": "#/$defs/artifact"},
    "workflow_profile": {"$ref": "#/$defs/artifact"},
    "biological_profile": {"$ref": "#/$defs/artifact"},
    "candidate_catalog": {"$ref": "#/$defs/artifact"},
    "atlas_bundle": {"$ref": "#/$defs/artifact"},
    "threshold_registry": {"$ref": "#/$defs/artifact"},
    "candidate_context_evidence": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/artifact"}]
    },
    "candidate_context_policy": {
      "type": "object",
      "required": [
        "scope", "identity_evidence_authority",
        "missing_or_not_evaluable_release_eligible",
        "all_candidate_release_outlets_must_recheck"
      ],
      "properties": {
        "scope": {"const": "evaluation_permission_only"},
        "identity_evidence_authority": {"const": false},
        "missing_or_not_evaluable_release_eligible": {"const": false},
        "all_candidate_release_outlets_must_recheck": {"const": true}
      },
      "additionalProperties": false
    },
    "selected_input_snapshot": {
      "type": "object",
      "required": ["registry_path", "snapshot_id", "sha256", "path", "artifact_role"],
      "properties": {
        "registry_path": {"type": "string", "minLength": 1},
        "snapshot_id": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "path": {"type": "string", "minLength": 1},
        "artifact_role": {"const": "runtime_input"}
      }
    },
    "query_input_audit": {
      "oneOf": [
        {"type": "null"},
        {
          "allOf": [
            {"$ref": "#/$defs/artifact"},
            {
              "type": "object",
              "required": [
                "raw_count_assay", "coordinate_columns", "expression_boundary"
              ],
              "properties": {
                "raw_count_assay": {
                  "type": "string", "minLength": 1,
                  "not": {"pattern": "^(?i:SCT)$"}
                },
                "coordinate_columns": {
                  "type": "array", "minItems": 2, "maxItems": 2,
                  "items": {"type": "string", "minLength": 1}
                },
                "expression_boundary": {
                  "const": "project-local non-SCT raw counts"
                }
              }
            }
          ]
        }
      ]
    },
    "input_scope": {
      "type": "object",
      "required": [
        "full_object", "analysis_set", "excluded_initial_qc",
        "analysis_set_n", "excluded_initial_qc_n",
        "biological_unresolved_is_initial_qc"
      ],
      "properties": {
        "full_object": {"$ref": "#/$defs/artifact"},
        "analysis_set": {"$ref": "#/$defs/artifact"},
        "excluded_initial_qc": {"$ref": "#/$defs/artifact"},
        "analysis_set_n": {"type": "integer", "minimum": 1},
        "excluded_initial_qc_n": {"type": "integer", "minimum": 0},
        "biological_unresolved_is_initial_qc": {"const": false}
      },
      "additionalProperties": false
    },
    "artifact_role_policy": {
      "type": "object",
      "required": ["runtime_allowed_roles", "failed_diagnostic_runtime_forbidden", "diagnostic_registry"],
      "properties": {
        "runtime_allowed_roles": {"const": ["runtime_input", "external_reference"]},
        "failed_diagnostic_runtime_forbidden": {"const": true},
        "diagnostic_registry": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/artifact"}]
        }
      }
    },
    "expression_ancestry_policy": {
      "type": "object",
      "required": ["project_local_query_evidence", "cross_project_expression_requires_external_reference"],
      "properties": {
        "project_local_query_evidence": {"const": true},
        "cross_project_expression_requires_external_reference": {"const": true}
      }
    },
    "whole_tissue_partition": {
      "type": "object",
      "required": ["method", "candidate_grid_source", "candidate_resolutions", "partition_grid", "selection_endpoint", "formal_membership_authority"],
      "properties": {
        "method": {"enum": ["BANKSY", "Seurat", "Scanpy", "external"]},
        "candidate_grid_source": {"enum": ["bound_upstream_input", "fresh_project_computation"]},
        "candidate_resolutions": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"type": "number"}},
        "grid_artifact": {"$ref": "#/$defs/artifact"},
        "partition_grid": {"$ref": "#/$defs/artifact"},
        "selection_endpoint": {"const": "stable_cohort_partition"},
        "formal_membership_authority": {"const": false}
      },
      "allOf": [{
        "if": {"properties": {"candidate_grid_source": {"const": "bound_upstream_input"}}},
        "then": {"required": ["grid_artifact"]}
      }]
    },
    "query_reclustering": {
      "type": "object",
      "required": [
        "candidate_resolutions", "separate_from_upstream_banksy_grid",
        "cohort_unit", "normalization_path", "full_catalog_scan_required",
        "provisional_broad_blinded_until_score_freeze",
        "resolution_stability_neighbors"
      ],
      "properties": {
        "candidate_resolutions": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"type": "number"}},
        "separate_from_upstream_banksy_grid": {"const": true},
        "cohort_unit": {"const": "initial_cluster"},
        "normalization_path": {"const": "raw_counts_SCTv2_PCA_SNN_Leiden"},
        "full_catalog_scan_required": {"const": true},
        "provisional_broad_blinded_until_score_freeze": {"const": true},
        "resolution_stability_neighbors": {"const": "nearest_lower_and_higher_else_two_nearest"}
      }
    },
    "broad_family_evidence": {
      "type": "object",
      "required": ["required", "feature_scope", "complete_cartesian_product"],
      "properties": {
        "required": {"const": true},
        "feature_scope": {"const": "full_feature"},
        "complete_cartesian_product": {"const": true}
      }
    },
    "canonical_lineage_controller": {
      "type": "object",
      "required": [
        "controller_version", "formal_release_requires_canonical_chain",
        "historical_labels_blinded_until_membership_freeze", "phase_order",
        "phase_authority", "random_seed", "resolution_selector",
        "resolution_evidence_builder", "unmodeled_discovery",
        "cohort_reclustering", "scripts", "dependencies", "scoring_policy",
        "subset_policy", "remainder_policy", "catalog_wide_review_policy",
        "runtime_dependency_registry_version"
      ],
      "properties": {
        "controller_version": {"const": "2.2.0"},
        "formal_release_requires_canonical_chain": {"const": true},
        "historical_labels_blinded_until_membership_freeze": {"const": true},
        "phase_order": {
          "const": [
            "whole_tissue_partition", "cluster_cohort_recluster",
            "local_mixed_subcluster_split", "merge_and_freeze_broad",
            "atlas_and_completeness_review", "materialize_final_release"
          ]
        },
        "phase_authority": {
          "type": "object",
          "required": [
            "whole_tissue_partition", "cluster_cohort_recluster",
            "local_mixed_subcluster_split", "merge_and_freeze_broad",
            "atlas_and_completeness_review", "materialize_final_release"
          ],
          "properties": {
            "whole_tissue_partition": {"const": "provisional_only_no_release_membership"},
            "cluster_cohort_recluster": {"const": "candidate_only_no_release_membership"},
            "local_mixed_subcluster_split": {"const": "candidate_only_no_release_membership"},
            "merge_and_freeze_broad": {"const": "formal_broad_freeze"},
            "atlas_and_completeness_review": {"const": "unlabeled_atlas_rescue_and_bounded_catalog_review"},
            "materialize_final_release": {"const": "final_broad_fine_state_release"}
          },
          "additionalProperties": false
        },
        "random_seed": {"type": "integer"},
        "resolution_selector": {"$ref": "#/$defs/artifact"},
        "resolution_evidence_builder": {"$ref": "#/$defs/artifact"},
        "unmodeled_discovery": {"$ref": "#/$defs/artifact"},
        "runtime_dependency_registry_version": {"type": "string", "minLength": 1},
        "scripts": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"$ref": "#/$defs/artifact"}
        },
        "dependencies": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"$ref": "#/$defs/artifact"}
        },
        "cohort_reclustering": {
          "type": "object",
          "required": ["entrypoint", "implementation", "sct_input_boundary", "clustering_path"],
          "properties": {
            "entrypoint": {"$ref": "#/$defs/artifact"},
            "implementation": {"$ref": "#/$defs/artifact"},
            "sct_input_boundary": {"const": "project_local_non_sct_raw_counts"},
            "clustering_path": {"const": "SCT_PCA_SNN_Leiden"}
          },
          "additionalProperties": false
        },
        "scoring_policy": {
          "type": "object",
          "required": [
            "gene_scale", "family_aggregation", "direct_weight",
            "local_weight", "anti_weight", "family_active_threshold",
            "local_gene_detection_fraction", "hard_contradiction"
          ],
          "properties": {
            "gene_scale": {"const": "query_nonzero_q95_capped"},
            "family_aggregation": {"const": "mean_top_two_available_genes"},
            "direct_weight": {"type": "number", "minimum": 0, "maximum": 1},
            "local_weight": {"type": "number", "minimum": 0, "maximum": 1},
            "anti_weight": {"type": "number", "minimum": 0, "maximum": 1},
            "family_active_threshold": {"type": "number", "minimum": 0, "maximum": 1},
            "local_gene_detection_fraction": {"type": "number", "minimum": 0, "maximum": 1},
            "hard_contradiction": {"const": "coherent_multigene_multifamily_direct_anti_only"}
          }
        },
        "subset_policy": {
          "type": "object",
          "required": [
            "candidate_local_independent_proposals", "aggregate_winner_can_veto",
            "identity_core_component_required",
            "generic_support_cell_transitive_bridging",
            "fine_candidate_parent_lock",
            "fine_candidate_discriminator_seed_required",
            "sparse_tail_inheritance_scope",
            "subset_validation_supported_fraction",
            "subset_validation_competitor_margin",
            "maximum_contradiction_fraction", "maximum_second_subset_rounds",
            "activation_scope"
          ],
          "properties": {
            "candidate_local_independent_proposals": {"const": true},
            "aggregate_winner_can_veto": {"const": false},
            "identity_core_component_required": {"const": true},
            "generic_support_cell_transitive_bridging": {"const": false},
            "fine_candidate_parent_lock": {"const": true},
            "fine_candidate_discriminator_seed_required": {"const": true},
            "sparse_tail_inheritance_scope": {"const": "validated_high_purity_expression_subcluster_only"},
            "subset_validation_supported_fraction": {"type": "number", "minimum": 0, "maximum": 1},
            "subset_validation_competitor_margin": {"type": "number", "minimum": 0, "maximum": 1},
            "maximum_contradiction_fraction": {"type": "number", "minimum": 0, "maximum": 1},
            "maximum_second_subset_rounds": {"type": "integer", "minimum": 0, "maximum": 2},
            "activation_scope": {"const": "second_round_mixed_subcluster_only"}
          }
        },
        "remainder_policy": {
          "type": "object",
          "required": ["allowed_scopes", "first_round_forbidden", "unselected_member_is_qc"],
          "properties": {
            "allowed_scopes": {"const": ["local_mixed_subcluster", "post_merge_reconciliation"]},
            "first_round_forbidden": {"const": true},
            "unselected_member_is_qc": {"const": false}
          }
        },
        "catalog_wide_review_policy": {
          "type": "object",
          "required": [
            "scope", "primary_unit", "whole_object_per_cell_classifier",
            "stable_partition_reuse_default", "maximum_decision_rounds"
          ],
          "properties": {
            "scope": {"const": "every_context_evaluable_broad"},
            "primary_unit": {"const": "broad_cell_type"},
            "whole_object_per_cell_classifier": {"const": false},
            "stable_partition_reuse_default": {"const": true},
            "maximum_decision_rounds": {"const": 1}
          },
          "additionalProperties": false
        }
      }
    },
    "observation_writeback": {
      "type": "object",
      "required": [
        "first_round_formal_writeback", "local_mixed_subcluster_only",
        "subset_writeback_required", "whole_subcluster_purity_evidence_required", "terminal_return_purity_audit_required",
        "raw_two_family_writeback_audit_required", "complete_fine_candidate_audit_required", "policy"
      ],
      "properties": {
        "first_round_formal_writeback": {"const": false},
        "local_mixed_subcluster_only": {"const": true},
        "subset_writeback_required": {"type": "boolean"},
        "whole_subcluster_purity_evidence_required": {"type": "boolean"},
        "terminal_return_purity_audit_required": {"type": "boolean"},
        "raw_two_family_writeback_audit_required": {"type": "boolean"},
        "complete_fine_candidate_audit_required": {"type": "boolean"},
        "fine_writeback_broad_lock_required": {"type": "boolean"},
        "final_fine_state_validation_required": {"type": "boolean"},
        "policy": {
          "type": "object",
          "required": [
            "whole_subcluster_min_lineage_supported_fraction",
            "whole_subcluster_min_purity_margin",
            "whole_subcluster_min_raw_two_family_supported_fraction",
            "whole_subcluster_min_raw_two_family_margin",
            "whole_subcluster_embedded_competitor_raw_trigger",
            "whole_subcluster_dominant_seed_fraction",
            "whole_subcluster_dominant_direct_core_fraction",
            "whole_subcluster_dominant_identity_core_fraction",
            "whole_subcluster_dominant_max_contradiction_fraction",
            "supported_subset_min_lineage_supported_fraction",
            "supported_subset_min_purity_margin",
            "present_label_min_lineage_supported_fraction",
            "present_label_min_purity_margin",
            "maximum_contradiction_fraction"
          ],
          "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    },
    "atlas_routing": {
      "type": "object",
      "required": [
        "authoritative_router", "bundle_id", "capability_matrix_enforced",
        "runtime_atlas_substitution_forbidden", "mapping_scope",
        "writeback_scope", "fine_anchor_eligible"
      ],
      "properties": {
        "authoritative_router": {"const": "route_global_atlas_v2.py"},
        "bundle_id": {"enum": ["sheep_ovary_GSE233801_split_wall_v2", "sheep_ovary_GSE233801_v1"]},
        "capability_matrix_enforced": {"const": true},
        "runtime_atlas_substitution_forbidden": {"const": true},
        "mapping_scope": {"const": "complete_analysis_set"},
        "writeback_scope": {"const": "unlabeled_after_broad_merge_only"},
        "fine_anchor_eligible": {"const": false}
      }
    },
    "release_taxonomy": {
      "type": "object",
      "required": [
        "independent_vascular_lineages", "lymphatic_parent",
        "legacy_vascular_associated_release_forbidden",
        "single_public_annotation_column", "hierarchy_validation_required"
      ],
      "properties": {
        "independent_vascular_lineages": {
          "const": ["Endothelial", "Pericyte/mural", "Smooth muscle"]
        },
        "lymphatic_parent": {"const": "Endothelial"},
        "legacy_vascular_associated_release_forbidden": {"const": true},
        "single_public_annotation_column": {"const": "final_cell_type"},
        "hierarchy_validation_required": {"const": true}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "required": ["path", "sha256", "artifact_role"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "artifact_role": {
          "enum": ["runtime_input", "external_reference", "failed_diagnostic_registry"]
        }
      }
    }
  }
}
